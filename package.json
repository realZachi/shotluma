{
  "name": "shotluma",
  "description": "An AI-first, local-first canvas editor for editable App Store screenshot sets.",
  "private": true,
  "version": "0.5.0",
  "license": "MIT",
  "packageManager": "bun@1.3.9",
  "overrides": {
    "@hono/node-server": "2.0.10",
    "@modelcontextprotocol/sdk": "1.32.1",
    "baseline-browser-mapping": "2.11.30",
    "brace-expansion": "5.0.12",
    "browserslist": "4.29.4",
    "fast-uri": "3.1.8",
    "hono": "4.13.13",
    "ip-address": "10.7.4",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "postcss-selector-parser": "7.1.6",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "undici": "7.29.1"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "codex:bridge": "bun scripts/shotluma-codex-bridge.ts",
    "typecheck": "tsc -b",
    "build": "bun run typecheck && vite build",
    "deploy": "bun run build && wrangler deploy",
    "deploy-only": "wrangler deploy",
    "preview": "vite preview",
    "structure": "bun scripts/check-structure.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "bun run lint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit": "bun audit --ignore=GHSA-vfj7-8cjw-p6xm",
    "check": "bun run structure && bun run lint && bun run test:coverage && bun run build && bun run audit"
  },
  "dependencies": {
    "@ai-sdk/alibaba": "^2.0.16",
    "@ai-sdk/anthropic": "4.0.20",
    "@ai-sdk/google": "^4.0.23",
    "@ai-sdk/openai": "^4.0.19",
    "@ai-sdk/xai": "^4.0.40",
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/bricolage-grotesque": "latest",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/instrument-sans": "latest",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource-variable/syne": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/fraunces": "latest",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@tailwindcss/vite": "^4.3.3",
    "ai": "^7.0.31",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-image": "latest",
    "jszip": "latest",
    "react": "latest",
    "react-dom": "latest",
    "shadcn": "4.16.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "latest",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "fake-indexeddb": "^6.2.5",
    "globals": "latest",
    "jsdom": "^29.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "^4.1.12",
    "wrangler": "4.118.0"
  }
}
