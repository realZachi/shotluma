{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shotluma-app",
  "compatibility_date": "2026-08-03",
  "main": "scripts/shotluma-worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/opencode/*"]
  },
  "routes": [
    {
      "pattern": "app.shotluma.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
